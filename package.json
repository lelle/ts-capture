{
  "name": "ts-capture-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "ts-capture — capture runtime values, shape them as TypeScript types",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "pretest": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint && eslint .",
    "lint:knip": "knip",
    "lint:types": "eslint --no-config-lookup --config eslint.typed.mjs packages/*/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "examples": "pnpm --filter @ts-capture/core run build && pnpm --filter @ts-capture/examples-site run build && pnpm --filter @ts-capture/examples-site run site",
    "site": "pnpm --filter @ts-capture/examples-site run preview",
    "demo": "pnpm --filter @ts-capture/core --filter @ts-capture/vite --filter @ts-capture/examples-site --filter @ts-capture/demo run build && pnpm --filter @ts-capture/demo run record",
    "verify": "bash scripts/ci.sh",
    "clean": "pnpm -r exec rm -rf dist node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "10.12.0",
    "eslint-plugin-jsdoc": "65.2.4",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-regexp": "3.3.1",
    "husky": "9.1.7",
    "knip": "6.41.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "packageManager": "pnpm@12.12.0+sha512.2ee06ac86db554cf384421461220f0e336a487bfd41b2acd04e17a86b1487832fe45e8d1743f7fc52acc77de12d2356b536fedf8229fc483239e40b13d474449"
}
