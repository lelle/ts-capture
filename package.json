{
  "name": "ts-capture-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "ts-capture — capture runtime values, shape them as TypeScript types",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "pretest": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint && eslint .",
    "lint:knip": "knip",
    "lint:types": "eslint --no-config-lookup --config eslint.typed.mjs packages/*/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "bash scripts/ci.sh",
    "clean": "pnpm -r exec rm -rf dist node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "eslint": "10.8.1",
    "eslint-plugin-jsdoc": "64.0.2",
    "eslint-plugin-perfectionist": "5.10.1",
    "eslint-plugin-regexp": "3.1.1",
    "husky": "9.1.7",
    "knip": "6.32.0",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
