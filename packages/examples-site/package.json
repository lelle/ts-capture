{
  "name": "@ts-capture/examples-site",
  "version": "0.0.0",
  "private": true,
  "description": "Builds the ts-capture examples page and the browser playground.",
  "type": "module",
  "exports": {
    "./code": {
      "types": "./dist/code.d.ts",
      "default": "./dist/code.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "site": "node dist/build.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src/ --deny-warnings"
  },
  "license": "MIT",
  "dependencies": {
    "@ts-capture/core": "workspace:*",
    "marked": "18.1.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@typescript/vfs": "1.6.5",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "oxlint": "1.87.0",
    "vitest": "4.1.11"
  }
}
