{
  "name": "@ts-capture/demo",
  "version": "0.0.0",
  "private": true,
  "description": "The order form behind the README recording, and the script that records it.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "record": "node dist/record.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src/ --deny-warnings"
  },
  "license": "MIT",
  "dependencies": {
    "@ts-capture/core": "workspace:*",
    "@ts-capture/examples-site": "workspace:*",
    "@ts-capture/vite": "workspace:*",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "oxlint": "1.77.0",
    "vitest": "4.1.11"
  }
}
